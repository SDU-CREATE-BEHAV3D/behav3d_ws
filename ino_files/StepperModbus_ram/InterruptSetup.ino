void enableTimer4(bool enable) {
  if (enable) TIMSK4 |= (1 << OCIE4A) | (1 << OCIE4B) | (1 << TOIE4);
  else TIMSK4 &= ~((1 << OCIE4A) | (1 << OCIE4B) | (1 << TOIE4));
}

ISR(TIMER4_COMPA_vect) {
  PORTH |= (1 << 5);
}

ISR(TIMER4_COMPB_vect) {
  TCNT4 = 0;
  PORTH &= ~(1 << 5);
}

ISR(TIMER4_OVF_vect) {
}
